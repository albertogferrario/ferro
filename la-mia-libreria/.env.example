# Copy to `.env` and adjust as needed.

# SQLite is the simplest option; the file is created automatically.
DATABASE_URL=sqlite://./database.db

# Where the web server listens.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# App identity (used by Ferro framework conventions).
APP_NAME=La Mia Libreria
APP_URL=http://127.0.0.1:8080
