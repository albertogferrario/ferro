# Generated by ferro docker:init (ferro ref: main)
# Do not hand-edit; rerun ferro docker:init --force instead

# ============ Stage: frontend-builder ============
FROM node:22-slim AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ============ Stage: chef (cargo-chef base) ============
FROM rust:1.88-slim-bookworm AS chef
RUN cargo install cargo-chef
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG GITHUB_TOKEN=""
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

# ============ Stage: planner ============
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./

COPY src/ ./src/
COPY scripts/ ./scripts/
RUN bash scripts/rewrite-ferro-deps.sh
RUN cargo chef prepare --recipe-path recipe.json

# ============ Stage: backend-builder ============
FROM chef AS backend-builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./

COPY src/ ./src/
COPY scripts/ ./scripts/
RUN bash scripts/rewrite-ferro-deps.sh
RUN cargo build --release --bin mkmenu

# ============ Stage: runtime ============
FROM debian:bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser
COPY --from=backend-builder --chown=appuser:appuser /app/target/release/mkmenu /usr/local/bin/mkmenu

RUN mkdir -p storage/app/public && chown -R appuser:appuser storage
USER appuser
ENV APP_ENV=production
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mkmenu"]
