# ==============================================================================
# APPLICATION
# ==============================================================================
APP_NAME=gestiscilo
APP_ENV=local
APP_DEBUG=true
# Canonical public URL used in magic links, QR codes, and booking confirmations.
APP_URL=http://localhost:8080
# Used in Stripe redirects and SEO canonical tags; keep in sync with APP_URL.
BASE_URL=http://localhost:8080

# ==============================================================================
# LOCALIZATION
# ==============================================================================
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
LANG_PATH=lang

# ==============================================================================
# SERVER
# ==============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=sqlite://./database.db
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT=10
DB_LOGGING=false

# ==============================================================================
# SESSION
# ==============================================================================
SESSION_LIFETIME=10080
SESSION_ABSOLUTE_LIFETIME=43200
SESSION_COOKIE=gestiscilo_session
# Set true in production over HTTPS.
SESSION_SECURE=false
SESSION_PATH=/
SESSION_SAME_SITE=lax

# ==============================================================================
# CACHE / QUEUE (ferro framework)
# ==============================================================================
CACHE_DRIVER=memory
CACHE_PREFIX=gestiscilo_
QUEUE_CONNECTION=database
QUEUE_DEFAULT=default
QUEUE_RETRY_AFTER=90

# ==============================================================================
# STORAGE (ferro-storage — S3/DigitalOcean Spaces abstraction layer)
# FILESYSTEM_DISK: "local" for dev, "s3" for production (DigitalOcean Spaces).
# AWS_URL sets the custom S3-compatible endpoint for non-AWS providers.
# ==============================================================================
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_URL=/storage
STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fra1
AWS_BUCKET=
AWS_URL=

# ==============================================================================
# MAIL
# ==============================================================================
MAIL_DRIVER=resend
MAIL_FROM_ADDRESS=noreply@mail.gestiscilo.it
MAIL_FROM_NAME=gestiscilo.it
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# ==============================================================================
# STRIPE
# ==============================================================================
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# WHATSAPP
# ==============================================================================
# Meta App Dashboard → Settings → Basic → App Secret
WHATSAPP_APP_SECRET=
# Arbitrary string; must match Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=

# ==============================================================================
# AI
# ==============================================================================
# https://console.anthropic.com/ — used for WhatsApp command classification
ANTHROPIC_API_KEY=

# ==============================================================================
# DEBUG
# ==============================================================================
# Seeds test@gestiscilo.it + Pizzeria Mario demo on first boot.
# Code checks == "true" literal — not 1, not yes.
SEED_DEMO_DATA=true
FERRO_COLLECT_METRICS=false
