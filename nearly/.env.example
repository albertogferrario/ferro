# Nearly — example environment. Copy to `.env` and adjust.

# App identity (read by ferro framework conventions)
APP_NAME=Nearly
APP_URL=http://localhost:8080

# APP_ENV controls the Inertia asset mode:
#   local / dev  → use the Vite dev server (run `npm run dev` in frontend/)
#   production   → serve the built manifest assets from public/
APP_ENV=local

# Vite dev server (used when APP_ENV is not production/staging)
VITE_DEV_SERVER=http://localhost:5173

# Database — SQLite by default; Postgres also supported.
DATABASE_URL=sqlite://./nearly.db

# Session
SESSION_DRIVER=database
