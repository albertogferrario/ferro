{
  "$schema": "ferro-json-ui/v2",
  "title": "Trilli",
  "layout": "dashboard",
  "design": { "intent": "browse" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["header", "table"]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "I tuoi trilli",
        "subtitle": "Qualcuno ti ha notato. Rispondi… di persona."
      }
    },
    "table": {
      "type": "DataTable",
      "props": {
        "columns": [
          { "key": "from", "label": "Da" },
          { "key": "status", "label": "Stato" }
        ],
        "data_path": "/trilli",
        "row_key": "id",
        "empty_message": "Ancora nessun trillo. Fatti trovare sulla mappa!",
        "row_actions": [
          {
            "label": "Accetta",
            "action": { "handler": "/trilli/{row_key}/accept", "method": "POST" }
          },
          {
            "label": "Ignora",
            "action": { "handler": "/trilli/{row_key}/decline", "method": "POST" }
          }
        ]
      }
    }
  }
}
