{
  "$schema": "ferro-json-ui/v2",
  "title": "Luoghi",
  "layout": "dashboard",
  "design": { "intent": "browse" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["header", "table"]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Luoghi di tendenza",
        "subtitle": "I posti più vivi in città. I premium restano sempre in vista."
      }
    },
    "table": {
      "type": "DataTable",
      "props": {
        "columns": [
          { "key": "name", "label": "Luogo" },
          { "key": "category", "label": "Categoria" },
          { "key": "badge", "label": "" }
        ],
        "data_path": "/places",
        "row_key": "id",
        "empty_message": "Nessun luogo ancora. Torna più tardi."
      }
    }
  }
}
