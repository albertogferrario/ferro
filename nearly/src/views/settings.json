{
  "$schema": "ferro-json-ui/v2",
  "title": "Impostazioni",
  "layout": "dashboard",
  "design": { "intent": "collect" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["header", "form", "about"]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Impostazioni",
        "breadcrumb": [{ "label": "Mappa", "url": "/map" }]
      }
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/settings", "method": "POST" },
        "method": "POST",
        "max_width": "narrow"
      },
      "children": ["visible_switch", "submit"]
    },
    "visible_switch": {
      "type": "Switch",
      "props": {
        "field": "visible",
        "label": "Visibile sulla mappa",
        "description": "Se disattivato, gli altri non ti vedranno tra i pin.",
        "data_path": "/visible"
      }
    },
    "submit": {
      "type": "Button",
      "props": { "label": "Salva", "button_type": "submit", "variant": "primary" }
    },
    "about": {
      "type": "Card",
      "props": {
        "title": "Informazioni",
        "description": "Nearly — incontra le persone intorno a te, di persona. Nessuna chat, solo un trillo.",
        "appearance": "outlined"
      }
    }
  }
}
