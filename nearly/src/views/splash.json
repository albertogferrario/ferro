{
  "$schema": "ferro-json-ui/v2",
  "title": "Nearly",
  "layout": "auth",
  "design": { "intent": "focus" },
  "root": "card",
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Nearly",
        "description": "Scopri chi e cosa ti circonda — di persona, non in chat.",
        "appearance": "elevated"
      },
      "children": ["explore", "signin", "signup"]
    },
    "explore": {
      "type": "Button",
      "props": { "label": "Esplora la mappa", "variant": "primary" },
      "action": { "handler": "/map", "method": "GET" }
    },
    "signin": {
      "type": "Button",
      "props": { "label": "Accedi", "variant": "secondary" },
      "action": { "handler": "/login", "method": "GET" }
    },
    "signup": {
      "type": "Button",
      "props": { "label": "Crea un account", "variant": "ghost" },
      "action": { "handler": "/register", "method": "GET" }
    }
  }
}
