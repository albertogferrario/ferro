{
  "$schema": "ferro-json-ui/v2",
  "title": "Account",
  "layout": "dashboard",
  "design": { "intent": "collect" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["header", "card"]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Account",
        "breadcrumb": [{ "label": "Mappa", "url": "/map" }]
      }
    },
    "card": {
      "type": "Card",
      "props": {
        "title": "Il tuo profilo",
        "description": "Come ti vedono le persone vicine.",
        "appearance": "elevated"
      },
      "children": ["form"]
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/account", "method": "POST" },
        "method": "POST",
        "max_width": "narrow"
      },
      "children": ["display_name", "status", "submit"]
    },
    "display_name": {
      "type": "Input",
      "props": {
        "field": "display_name",
        "label": "Nome visualizzato",
        "input_type": "text",
        "required": true,
        "default_value": { "$data": "/display_name" }
      }
    },
    "status": {
      "type": "Input",
      "props": {
        "field": "status",
        "label": "Status",
        "input_type": "text",
        "default_value": { "$data": "/status" }
      }
    },
    "submit": {
      "type": "Button",
      "props": { "label": "Salva", "button_type": "submit", "variant": "primary" }
    }
  }
}
