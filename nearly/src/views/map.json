{
  "$schema": "ferro-json-ui/v2",
  "title": "Mappa",
  "layout": "dashboard",
  "design": { "intent": "track" },
  "fill_viewport": true,
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1, "fill": true },
      "children": ["header", "map"]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Chi c'è intorno a te",
        "subtitle": "Tocca un pin per vedere il profilo e inviare un trillo."
      }
    },
    "map": {
      "type": "Map",
      "props": {
        "center": { "$data": "/center" },
        "zoom": 14,
        "height": "78vh",
        "markers": { "$data": "/markers" }
      }
    }
  }
}
