{
  "$schema": "ferro-json-ui/v2",
  "title": "Profilo",
  "layout": "dashboard",
  "design": { "intent": "focus" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["header", "card"]
    },
    "header": {
      "type": "PageHeader",
      "props": {
        "title": "Profilo",
        "breadcrumb": [{ "label": "Mappa", "url": "/map" }]
      }
    },
    "card": {
      "type": "Card",
      "props": {
        "title": { "$data": "/display_name" },
        "description": { "$data": "/status" },
        "appearance": "elevated"
      },
      "children": ["hint", "form", "back"]
    },
    "hint": {
      "type": "Text",
      "props": {
        "content": "Su Nearly non c'è la chat: manda un trillo e presentati di persona.",
        "variant": "muted"
      }
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/trilli", "method": "POST" },
        "method": "POST",
        "max_width": "narrow"
      },
      "children": ["to_user_id", "submit"]
    },
    "to_user_id": {
      "type": "Input",
      "props": {
        "field": "to_user_id",
        "input_type": "hidden",
        "default_value": { "$data": "/to_user_id" }
      }
    },
    "submit": {
      "type": "Button",
      "props": { "label": "Invia un trillo 🔔", "button_type": "submit", "variant": "primary" }
    },
    "back": {
      "type": "Button",
      "props": { "label": "Torna alla mappa", "variant": "ghost" },
      "action": { "handler": "/map", "method": "GET" }
    }
  }
}
