{
  "$schema": "ferro-json-ui/v2",
  "title": "Accedi",
  "layout": "auth",
  "design": { "intent": "collect" },
  "root": "card",
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Bentornato su Nearly",
        "description": "Accedi per continuare.",
        "appearance": "elevated"
      },
      "children": ["form", "to_register"]
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/login", "method": "POST" },
        "method": "POST",
        "max_width": "narrow"
      },
      "children": ["email", "password", "submit"]
    },
    "email": {
      "type": "Input",
      "props": {
        "field": "email",
        "label": "Email",
        "input_type": "email",
        "required": true,
        "data_path": "/email",
        "error": { "$data": "/error" }
      }
    },
    "password": {
      "type": "Input",
      "props": {
        "field": "password",
        "label": "Password",
        "input_type": "password",
        "required": true
      }
    },
    "submit": {
      "type": "Button",
      "props": { "label": "Accedi", "button_type": "submit", "variant": "primary" }
    },
    "to_register": {
      "type": "Button",
      "props": { "label": "Non hai un account? Registrati", "variant": "ghost" },
      "action": { "handler": "/register", "method": "GET" }
    }
  }
}
