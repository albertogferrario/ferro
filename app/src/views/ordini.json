{
  "$schema": "ferro-json-ui/v2",
  "title": "Ordini",
  "layout": "dashboard",
  "design": { "intent": "process" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["page_header", "board"]
    },
    "page_header": {
      "type": "PageHeader",
      "props": { "title": "Ordini" }
    },
    "board": {
      "type": "KanbanBoard",
      "props": {
        "columns": [
          { "id": "in_attesa", "title": "In attesa" },
          { "id": "in_lavorazione", "title": "In lavorazione" },
          { "id": "spedito", "title": "Spedito" }
        ],
        "items_path": "/ordini",
        "group_by": "stato",
        "card_title_key": "titolo",
        "card_description_key": "descrizione",
        "row_key": "id",
        "empty_label": "Nessun ordine",
        "row_actions": [
          {
            "label": "Vedi dettagli",
            "action": { "handler": "/ordini/{row_key}", "method": "GET" }
          },
          {
            "label": "Elimina",
            "destructive": true,
            "action": {
              "handler": "/ordini/{row_key}/elimina",
              "method": "POST",
              "confirm": {
                "title": "Eliminare l'ordine?",
                "message": "L'operazione non può essere annullata.",
                "tone": "destructive"
              }
            }
          }
        ]
      }
    }
  }
}
