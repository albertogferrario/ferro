{
  "$schema": "ferro-json-ui/v2",
  "title": "Nuovo prodotto",
  "layout": "dashboard",
  "design": { "intent": "collect" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1, "max_width": "narrow" },
      "children": ["page_header", "form_card"]
    },
    "page_header": {
      "type": "PageHeader",
      "props": {
        "title": "Nuovo prodotto",
        "breadcrumb": [
          { "label": "Prodotti", "url": "/prodotti" }
        ]
      }
    },
    "form_card": {
      "type": "Card",
      "props": {
        "title": "Dati prodotto",
        "description": "Compila i campi e salva per aggiungere il prodotto al catalogo."
      },
      "children": ["form"]
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/prodotti", "method": "POST" },
        "method": "POST"
      },
      "children": ["nome", "categoria", "prezzo", "quantita", "submit"]
    },
    "nome": {
      "type": "Input",
      "props": {
        "field": "nome",
        "label": "Nome",
        "required": true,
        "placeholder": "Nome del prodotto"
      }
    },
    "categoria": {
      "type": "Select",
      "props": {
        "field": "categoria",
        "label": "Categoria",
        "required": true,
        "default_value": "abbigliamento",
        "options": [
          { "value": "abbigliamento", "label": "Abbigliamento" },
          { "value": "accessori", "label": "Accessori" },
          { "value": "calzature", "label": "Calzature" }
        ]
      }
    },
    "prezzo": {
      "type": "Input",
      "props": {
        "field": "prezzo",
        "label": "Prezzo (€)",
        "input_type": "number",
        "step": "0.01",
        "required": true,
        "placeholder": "0,00"
      }
    },
    "quantita": {
      "type": "Input",
      "props": {
        "field": "quantita",
        "label": "Quantità",
        "input_type": "number",
        "required": true,
        "default_value": "1"
      }
    },
    "submit": {
      "type": "Button",
      "props": {
        "label": "Salva prodotto",
        "button_type": "submit",
        "variant": "primary"
      }
    }
  }
}
