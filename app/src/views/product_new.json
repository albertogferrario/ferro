{
  "$schema": "ferro-json-ui/v2",
  "title": "New product",
  "layout": "dashboard",
  "design": { "intent": "collect" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["page_header", "content_row"]
    },
    "page_header": {
      "type": "PageHeader",
      "props": {
        "title": "New product",
        "breadcrumb": [
          { "label": "Products", "url": "/products" }
        ]
      }
    },
    "content_row": {
      "type": "Grid",
      "props": { "columns": 1, "md_columns": 3, "gap": "lg", "spans": [2, 1] },
      "children": ["form_card", "info_card"]
    },
    "form_card": {
      "type": "Card",
      "props": {
        "title": "Product details",
        "description": "Fill in the fields and save to add the product to the catalog."
      },
      "children": ["form"]
    },
    "info_card": {
      "type": "Card",
      "props": {
        "title": "Tips",
        "description": "How to fill in the product form."
      },
      "children": ["tip_name", "tip_price", "tip_quantity"]
    },
    "tip_name": {
      "type": "Text",
      "props": {
        "content": "The name appears in the catalog and receipts: use a short, recognizable description.",
        "element": "p"
      }
    },
    "tip_price": {
      "type": "Text",
      "props": {
        "content": "The price is VAT-inclusive and uses a period as the decimal separator (e.g. 12.50).",
        "element": "p"
      }
    },
    "tip_quantity": {
      "type": "Text",
      "props": {
        "content": "The quantity indicates initial stock: you can update it at any time from the product list.",
        "element": "p"
      }
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/products", "method": "POST" },
        "method": "POST"
      },
      "children": ["name", "category", "price", "quantity", "submit"]
    },
    "name": {
      "type": "Input",
      "props": {
        "field": "name",
        "label": "Name",
        "required": true,
        "placeholder": "Product name"
      }
    },
    "category": {
      "type": "Select",
      "props": {
        "field": "category",
        "label": "Category",
        "required": true,
        "default_value": "clothing",
        "options": [
          { "value": "clothing", "label": "Clothing" },
          { "value": "accessories", "label": "Accessories" },
          { "value": "footwear", "label": "Footwear" }
        ]
      }
    },
    "price": {
      "type": "Input",
      "props": {
        "field": "price",
        "label": "Price (€)",
        "input_type": "number",
        "step": "0.01",
        "required": true,
        "placeholder": "0.00"
      }
    },
    "quantity": {
      "type": "Input",
      "props": {
        "field": "quantity",
        "label": "Quantity",
        "input_type": "number",
        "required": true,
        "default_value": "1"
      }
    },
    "submit": {
      "type": "Button",
      "props": {
        "label": "Save product",
        "button_type": "submit",
        "variant": "primary"
      }
    }
  }
}
