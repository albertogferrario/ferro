{
  "$schema": "ferro-json-ui/v2",
  "title": "Payments",
  "layout": "dashboard",
  "design": { "intent": "summarize" },
  "root": "root",
  "elements": {
    "root": {
      "type": "Grid",
      "props": { "columns": 1 },
      "children": ["page_header", "stats_row", "payments_table"]
    },
    "page_header": {
      "type": "PageHeader",
      "props": { "title": "Payments" }
    },
    "stats_row": {
      "type": "StatCard",
      "props": {
        "label": "Total",
        "value": { "$data": "/meta/total_formatted" }
      }
    },
    "payments_table": {
      "type": "DataTable",
      "props": {
        "columns": [
          { "key": "date", "label": "Date" },
          { "key": "description", "label": "Description" },
          { "key": "amount", "label": "Amount" },
          { "key": "status", "label": "Status" }
        ],
        "data_path": "/payments",
        "empty_message": "No payments found."
      }
    }
  }
}
