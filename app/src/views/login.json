{
  "$schema": "ferro-json-ui/v2",
  "title": "Sign in",
  "layout": "auth",
  "root": "card",
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Sign in",
        "description": "Enter your email to receive a login link.",
        "variant": "elevated"
      },
      "children": ["form"]
    },
    "form": {
      "type": "Form",
      "props": {
        "action": { "handler": "/auth/login", "method": "POST" },
        "method": "POST",
        "max_width": "narrow"
      },
      "children": ["email", "submit"]
    },
    "email": {
      "type": "Input",
      "props": {
        "field": "email",
        "label": "Email",
        "input_type": "email",
        "required": true,
        "data_path": "/email",
        "error": { "$data": "/error" }
      }
    },
    "submit": {
      "type": "Button",
      "props": {
        "label": "Send login link",
        "button_type": "submit",
        "variant": "default"
      }
    }
  }
}
