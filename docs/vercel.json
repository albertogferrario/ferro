{
  "buildCommand": "curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --retry-connrefused --connect-timeout 30 -o mdbook.tar.gz https://github.com/rust-lang/mdBook/releases/download/v0.4.40/mdbook-v0.4.40-x86_64-unknown-linux-gnu.tar.gz && tar -xzf mdbook.tar.gz && ./mdbook build",
  "outputDirectory": "book",
  "installCommand": "echo 'No install needed'"
}
