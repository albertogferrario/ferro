{
  "$id": "https://ferro-rs.dev/protocol/2026-03-01/warning.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural warnings from service and state machine validation.\n\nWarnings indicate potential issues that may be intentional\n(e.g., unreachable states reached via external means).",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "A state not reachable from the initial state via transitions.",
      "properties": {
        "unreachable_state": {
          "type": "string"
        }
      },
      "required": [
        "unreachable_state"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A non-final state with no outgoing transitions.",
      "properties": {
        "dead_end_state": {
          "type": "string"
        }
      },
      "required": [
        "dead_end_state"
      ],
      "type": "object"
    },
    {
      "const": "no_final_states",
      "description": "No states are marked as final.",
      "type": "string"
    },
    {
      "additionalProperties": false,
      "description": "A guard declared but never referenced by any transition or action precondition.",
      "properties": {
        "unused_guard": {
          "type": "string"
        }
      },
      "required": [
        "unused_guard"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "An action has a transition_trigger but the service has no state machine.",
      "properties": {
        "transition_trigger_without_state_machine": {
          "type": "string"
        }
      },
      "required": [
        "transition_trigger_without_state_machine"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Multiple relationships share the same name within a service.",
      "properties": {
        "duplicate_relationship": {
          "type": "string"
        }
      },
      "required": [
        "duplicate_relationship"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A many-to-many relationship has a foreign_key set (join tables have no single FK).",
      "properties": {
        "many_to_many_with_foreign_key": {
          "properties": {
            "relationship": {
              "type": "string"
            }
          },
          "required": [
            "relationship"
          ],
          "type": "object"
        }
      },
      "required": [
        "many_to_many_with_foreign_key"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Primary(X) and Exclude(X) for the same intent.",
      "properties": {
        "conflicting_intent_hints": {
          "properties": {
            "intent": {
              "type": "string"
            }
          },
          "required": [
            "intent"
          ],
          "type": "object"
        }
      },
      "required": [
        "conflicting_intent_hints"
      ],
      "type": "object"
    },
    {
      "const": "multiple_primary_intent_hints",
      "description": "More than one Primary hint specified.",
      "type": "string"
    }
  ],
  "title": "Warning"
}
