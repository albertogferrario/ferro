{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "data_type": {
      "$ref": "#/$defs/DataType"
    },
    "meaning": {
      "$ref": "#/$defs/FieldMeaning"
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "is_list": {
      "type": "boolean",
      "default": false
    },
    "readable": {
      "type": "boolean",
      "default": true
    },
    "writable": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "data_type",
    "meaning"
  ],
  "description": "A field definition within a service projection.",
  "title": "FieldDef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DataType": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "float",
        "boolean",
        "date_time",
        "date",
        "json",
        "binary",
        "uuid",
        "enum"
      ],
      "description": "Abstract data type categories for service fields.\n\nRepresents structural types independent of database storage details.\nMaps from database column types at introspection time."
    },
    "FieldMeaning": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "identifier",
            "foreign_key",
            "entity_name",
            "email",
            "phone",
            "url",
            "image_url",
            "money",
            "percentage",
            "quantity",
            "status",
            "category",
            "boolean",
            "free_text",
            "created_at",
            "updated_at",
            "date_time",
            "sensitive"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "Semantic field meaning. Known variants: identifier, foreign_key, entity_name, email, phone, url, image_url, money, percentage, quantity, status, category, boolean, free_text, created_at, updated_at, date_time, sensitive. Any other string is a custom domain-specific meaning."
    }
  },
  "$id": "https://ferro-rs.dev/protocol/2026-03-01/field-def.json"
}
